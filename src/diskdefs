# MY (DVK KMD controller), 80 tracks of 10 sectors of 512 bytes on both sides
diskdef my-800
  seclen 512
  heads 2
  tracks 80
  sectrk 10
  layout ibm-mfm
  indexmark 0
  gap1 42
  gap3 36
end

